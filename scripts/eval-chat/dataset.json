{
  "version": 2,
  "descripcion": "Eval agente-clientes-ia: mensajes realistas; aserciones genéricas (sin atar a SKUs concretos).",
  "escenarios": [
    {
      "id": "saludo-puro",
      "tags": ["smoke", "llm"],
      "descripcion": "Saludo — Opción A (LLM, sin tools obligatorias)",
      "turnos": ["hola"],
      "expect": {
        "respuestaContieneAny": ["hola", "ayud", "madomi", "qué", "como"],
        "maxToolCalls": 0,
        "noFallbackError": true,
        "noPlantillaSinCoincidencias": true,
        "presupuestoId": "absent",
        "minRespuestaLength": 12,
        "maxLatenciaMs": 120000
      }
    },
    {
      "id": "saludo-cordial",
      "tags": ["smoke", "llm"],
      "descripcion": "Small talk inicial",
      "turnos": ["buenas, qué tal?"],
      "expect": {
        "respuestaContieneAny": ["hola", "buenas", "ayud", "madomi", "qué", "tal"],
        "noFallbackError": true,
        "presupuestoId": "absent",
        "minRespuestaLength": 12,
        "maxLatenciaMs": 120000
      }
    },
    {
      "id": "novedades",
      "tags": ["llm", "catalogo"],
      "descripcion": "Novedades — debe usar catálogo, no nombres fijos",
      "turnos": ["productos nuevos"],
      "expect": {
        "respuestaCatalogoONovedades": true,
        "minToolCalls": 1,
        "noFallbackError": true,
        "noPlantillaSinCoincidencias": true,
        "presupuestoId": "absent",
        "minRespuestaLength": 40,
        "maxLatenciaMs": 120000
      }
    },
    {
      "id": "precio-bondiola",
      "tags": ["llm", "precio"],
      "descripcion": "Precio con producto nombrado en el mensaje (assert genérico de monto)",
      "turnos": ["cuánto sale la bondiola desmechada?"],
      "expect": {
        "montoArsEnRespuesta": true,
        "minToolCalls": 1,
        "noFallbackError": true,
        "noPlantillaSinCoincidencias": true,
        "presupuestoId": "absent",
        "minRespuestaLength": 25,
        "maxLatenciaMs": 120000
      }
    },
    {
      "id": "presupuesto-pide-localidad",
      "tags": ["llm", "presupuesto"],
      "descripcion": "Cantidades → debe orientar a localidad/envío antes del PDF",
      "turnos": ["10 unidades de bondiola"],
      "expect": {
        "pideLocalidadOEnvio": true,
        "respuestaContieneAny": ["cantidad", "unidad", "unidades", "anot", "producto", "presup"],
        "respuestaNoContiene": [".pdf", "supabase.co"],
        "noFallbackError": true,
        "presupuestoId": "absent",
        "minRespuestaLength": 30,
        "maxLatenciaMs": 120000
      }
    },
    {
      "id": "presupuesto-flujo-completo",
      "tags": ["llm", "presupuesto", "slow"],
      "descripcion": "Cantidades → contacto → localidad → presupuesto/PDF",
      "turnos": [
        "10 unidades de bondiola y 15 de guiso de lenteja",
        "Alejandro penalba 3815479768",
        "Soy de San Miguel de Tucuman"
      ],
      "expectPorTurno": [
        {
          "presupuestoId": "absent",
          "pideLocalidadOEnvio": true,
          "respuestaContieneAny": ["cantidad", "unidad", "anot", "producto", "presup"],
          "respuestaNoContiene": [".pdf", "supabase.co/storage"],
          "noFallbackError": true,
          "maxLatenciaMs": 120000
        },
        {
          "presupuestoId": "absent",
          "respuestaContieneAny": ["localidad", "barrio", "envío", "envio", "tel", "gracias", "anot", "datos"],
          "respuestaNoContiene": [".pdf", "supabase.co/storage"],
          "noFallbackError": true,
          "maxLatenciaMs": 120000
        },
        {
          "presupuestoId": "present",
          "respuestaContieneAny": ["presupuesto", "http", "total", "pdf"],
          "respuestaRegex": "(https?://|\\.pdf|ARS|\\$)",
          "montoArsEnRespuesta": true,
          "respuestaNoContiene": ["decime productos y cantidades otra vez", "no tengo productos"],
          "noFallbackError": true,
          "maxLatenciaMs": 180000
        }
      ]
    },
    {
      "id": "hilo-humita-correccion",
      "tags": ["llm", "contexto", "slow"],
      "descripcion": "Contexto multi-turno, seguimiento y corrección (mensajes con productos; asserts de comportamiento)",
      "turnos": [
        "para consultar el precio de los fideos",
        "No. pasame el precio de la bondiola y de la humita",
        "y la humita?",
        "busca bien el producto humita, su precio y stock",
        "y porque antes dijiste que no lo tenias al precio?"
      ],
      "expectPorTurno": [
        {
          "minRespuestaLength": 35,
          "respuestaContieneAny": ["precio", "fideo", "product", "variedad", "cuál", "?"],
          "noFallbackError": true,
          "noPlantillaSinCoincidencias": true,
          "maxLatenciaMs": 120000
        },
        {
          "montoArsEnRespuesta": true,
          "mencionaPrecioOStock": true,
          "noFallbackError": true,
          "noPlantillaSinCoincidencias": true,
          "minRespuestaLength": 30,
          "maxLatenciaMs": 120000
        },
        {
          "mencionaPrecioOStock": true,
          "noFallbackError": true,
          "noPlantillaSinCoincidencias": true,
          "minRespuestaLength": 25,
          "maxLatenciaMs": 120000
        },
        {
          "mencionaPrecioOStock": true,
          "minToolCalls": 1,
          "noFallbackError": true,
          "noPlantillaSinCoincidencias": true,
          "maxLatenciaMs": 120000
        },
        {
          "reconoceCorreccionOMeta": true,
          "noFallbackError": true,
          "noPlantillaSinCoincidencias": true,
          "minRespuestaLength": 25,
          "maxLatenciaMs": 120000
        }
      ]
    }
  ]
}
