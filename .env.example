# Backend — Madomi Landing
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/madomi-landing-db
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=clave-secreta-larga-minimo-32-caracteres
JWT_REFRESH_SECRET=otra-clave-secreta-distinta-minimo-32-caracteres
AUTH_ROL_DEFAULT=USUARIO

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=madomi-media

# Asistente comercial + CRM (MongoDB) — fase 2+
FEATURE_ASISTENTE=false
MONGODB_URI=mongodb://127.0.0.1:27017/madomi_crm
ASISTENTE_EMPRESA_SLUG=madomi
# orchestrador (recomendado) | cursor (= orquestador + opcional redacción Cursor cloud)
ASISTENTE_RUNTIME=orchestrador
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# cloud = único soportado para SDK en chat. NO usar local en POST /api/chat.
CURSOR_AGENT_TARGET=cloud
CURSOR_RUN_TIMEOUT_MS=90000
# Legacy: equivale a redacción Cursor si ASISTENTE_REDACT=auto y hay CURSOR_API_KEY.
CURSOR_SDK_REDACT=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Redacción estilo Assistant: auto | openai | cursor | none (si omitís y hay API key → auto)
# ASISTENTE_REDACT=auto
# Opcional: ruta custom al prompt (default docs/comercial/prompt-asistente-madomi.md)
# ASISTENTE_PROMPT_PATH=
# Legacy: true = fuerza redacción OpenAI (preferir ASISTENTE_REDACT=openai)
ASISTENTE_REDACT_OPENAI=false
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20
CHAT_HISTORIAL_MAX_MENSAJES=40
# comprometer (default) | descontar | ninguno — al confirmar compra (cerrarVenta)
ASISTENTE_STOCK_AL_CERRAR=comprometer
# deprecated: si true, equivale a ASISTENTE_STOCK_AL_CERRAR=descontar
ASISTENTE_DECREMENTAR_STOCK=false

# PDF presupuesto — layout vectorial (ver layoutMadomiV1.js; PNG solo referencia en repo)
# PRESUPUESTO_PDF_LAYOUT={"tabla":{"y":260}}
# PRESUPUESTO_PDF_DATOS_PAGO={"lineas":["CBU: ...","Madomi Pastas"]}
# PRESUPUESTO_PDF_CONDICIONES=
# PRESUPUESTO_PDF_OTROS_DETALLES=
# PRESUPUESTO_PDF_IVA_PORCENTAJE=0
# PRESUPUESTO_PDF_SITIO_WEB=www.madomipastas.com
